<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Ticket Details</title>
</head>
<body style="margin: 0; padding: 0; background-color: #f4f4f4; font-family: Arial, sans-serif;">
<br/>
  <table width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width: 744px; margin: 0 auto; background-color: #ffffff; border-radius: 10px;">
    
    <!-- Greeting -->
    <tr>
      <td style="padding: 20px;">
        <p style="margin: 0; font-size: 16px;">Dear <strong>{{username}}</strong>,</p>
        <p style="margin: 10px 0 0; font-size: 16px;">
          Thank you for registering for our event! Below are your ticket details:
        </p>
      </td>
    </tr>

    <!-- Event Banner -->
    <tr>
      <td style="padding: 20px; text-align: center;">
        <img src="{{image_banner}}" alt="Event Banner" style="width: 100%; max-width: 484px; border-radius: 10px; box-shadow: 0px 7px 13px -3px rgba(0, 0, 0, 0.1);" onerror="this.src='https://placehold.co/600x400?text=Image+unavailable'" />
      </td>
    </tr>

    <!-- Dashed Line -->
    <tr>
      <td style="border-bottom: 2px dashed #000000;"></td>
    </tr>

   <!-- Event Details -->
<tr>
  <td style="padding: 20px; text-align: center;">
    <table width="80%" cellpadding="0" cellspacing="0" border="0" align="center">
      <tr>
        <td width="50%" style="text-align: center;">
          <p style="margin: 0;">Location:</p>
          <p style="margin: 0; font-weight: bold;">{{location}}</p>
        </td>
        <td width="50%" style="text-align: center;">
          <p style="margin: 0;">Seat:</p>
          <p style="margin: 0; font-weight: bold;">N/A</p>
        </td>
      </tr>
    </table>
  </td>
</tr>

<!-- Name & Category -->
<tr>
  <td style="padding: 20px; text-align: center;">
    <table width="80%" cellpadding="0" cellspacing="0" border="0" align="center">
      <tr>
        <td width="50%" style="text-align: center;">
          <p style="margin: 0;">Name:</p>
          <p style="margin: 0; font-weight: bold;">{{event}}</p>
        </td>
        <td width="50%" style="text-align: center;">
          <p style="margin: 0;">Category:</p>
          <p style="margin: 0; font-weight: bold;">{{type}}</p>
        </td>
      </tr>
    </table>
  </td>
</tr>

 <!-- Time & Date -->
    <tr>
      <td style="padding: 20px; text-align: center;">
        <table width="80%" cellpadding="0" cellspacing="0" border="0" align="center">
          <tr>
            {{#if endTime}}
              <td width="50%" style="vertical-align: top;">
                <p style="margin: 0;">Time:</p>
                <p style="margin: 0; font-weight: bold;">{{time}} - {{endTime}}</p>
              </td>
            {{else}}
              <td width="50%" style="vertical-align: top;">
                <p style="margin: 0;">Time:</p>
                <p style="margin: 0; font-weight: bold;">{{time}}</p>
              </td>
            {{/if}}

            {{#if endDate}}
              <td width="50%" style="vertical-align: top;">
                <p style="margin: 0;">Date:</p>
                <p style="margin: 0; font-weight: bold;">{{date}} - {{endDate}}</p>
              </td>
            {{else}}
              <td width="50%" style="vertical-align: top;">
                <p style="margin: 0;">Date:</p>
                <p style="margin: 0; font-weight: bold;">{{date}}</p>
              </td>
            {{/if}}
          </tr>
        </table>
      </td>
    </tr>

    <!-- Dashed Line -->
    <tr>
      <td style="border-bottom: 2px dashed #000000;"></td>
    </tr>

    <!-- QR Code -->
    <tr>
      <td style="padding: 20px; text-align: center;">
        <img src="{{qrCode}}" alt="Ticket QR Code" style="width: 100%; max-width: 472px;" />
      </td>
    </tr>

  </table>

</body>
</html>
